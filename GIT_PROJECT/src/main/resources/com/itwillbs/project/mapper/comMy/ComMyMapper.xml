<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itwillbs.project.comMy.mapper.ComMyMapper">

<!-- ==============================
     resultMap
============================== -->
	<!-- ComMyDTO -->
	<resultMap id="userMap" type="com.itwillbs.project.comMy.dto.ComMyDTO">
	  <id     property="userId"   column="user_id" />
	  <result property="email"    column="email" />
	  <result property="userName" column="user_name" />
	  <result property="phone"    column="phone" />
	  <result property="userType" column="user_type" />
	</resultMap>
	
	<!-- ComJobRowDTO -->
	<resultMap id="comJobRowMap" type="com.itwillbs.project.comMy.dto.ComJobRowDTO">
	  <id     property="jobId"        column="job_id"/>
	
	  <result property="title"        column="title"/>
	  <result property="address"      column="address"/>
	  <result property="empType"      column="emp_type"/>
	
	  <!-- 화면용 날짜 -->
	  <result property="openDateText"  column="open_date_text"/>
	  <result property="closeDateText" column="close_date_text"/>
	
	  <!-- 지원자 수 -->
	  <result property="applyCount"   column="apply_count"/>
	
	  <!-- JSP에서 'OPEN'/'CLOSED' 비교 -->
	  <result property="postStatus"   column="post_status_text"/>
	</resultMap>
	
		<!-- PaymentDTO -->
	<resultMap id="paymentMap" type="com.itwillbs.project.comMy.dto.PaymentDTO">
		<id 	property="payId"  		   column="pay_id"  />
		<result property="userId" 		   column="user_id"/>
		<result property="productId" 	   column="product_id"/>
		<result property="payDate" 		   column="pay_date"/>
		<result property="productName" 	   column="product_name"/>
		<result property="payPrice" 	   column="pay_price"/>
		<result property="payStatus" 	   column="pay_status"/>
		<result property="payMethod" 	   column="pay_method"/>
		<result property="payDateText" 	   column="pay_date_text"/>
	</resultMap>
	
   
   <!-- =========================
       공통 where 조건
       - userId(comp_id)
       - status(all/open/closed)
       - q(검색: title/field)
       ========================= -->
	<sql id="jobWhere">
	  WHERE jp.comp_id = #{userId}
	
	  <if test="status != null and status != '' and status != 'all'">
	    <choose>
	      <when test="status == 'open'">
	        AND jp.post_status = 1
	      </when>
	      <when test="status == 'closed'">
	        AND jp.post_status &lt;&gt; 1
	      </when>
	    </choose>
	  </if>
	
	  <if test="q != null and q != ''">
	    AND (
	         jp.title LIKE CONCAT('%', #{q}, '%')
	      OR jp.field LIKE CONCAT('%', #{q}, '%')
	    )
	  </if>
	</sql>
	
	<!-- 결제 -->
<sql id="paymentWhere">
  WHERE p.user_id = #{userId}

  <!-- 기간 필터: period = 3m/6m/1y/5y -->
  <if test="period != null and period != ''">
    <choose>
      <when test="period == '3m'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 3 MONTH)
      </when>
      <when test="period == '6m'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 6 MONTH)
      </when>
      <when test="period == '1y'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 1 YEAR)
      </when>
      <when test="period == '5y'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 5 YEAR)
      </when>
      <otherwise>
        <!-- 아무것도 안 함-->
      </otherwise>
    </choose>
  </if>

  <!-- 상태 필터: status=all이면 조건 제외 -->
  <if test="status != null and status != '' and status != 'all'">
    <!-- DB enum이 ready/paid/cancelled라면 그대로 매칭 -->
    AND p.pay_status = #{status}
  </if>

  <!-- 검색어: 상품명 기준 -->
  <if test="q != null and q != ''">
    AND pr.product_name LIKE CONCAT('%', #{q}, '%')
  </if>
</sql>


<!-- ==============================
     내정보 조회
     parameter: sId
     result: ComMyDTO
============================== -->
	<select id="selectUser" parameterType="string" resultMap="userMap">
		SELECT user_id, email, user_name, phone, user_type
		FROM user
		WHERE email = #{sId}
	</select>
	
<!-- ==============================
     내정보 수정 저장
     parameter: MyDTO (email, userName, phone ...)
     result: int (affected rows)
============================== -->
	<update id="updateUser" parameterType="com.itwillbs.project.comMy.dto.ComMyDTO">
		 UPDATE user
		 SET user_name = #{userName},
		     phone = #{phone}
		 WHERE email = #{email}
	</update>
	
<!-- ==============================
     비밀번호 변경
     parameter: PasswordChangeDTO.java
     result: String
============================== -->	
	<select id="selectPassword" parameterType="string" resultType="string">
		SELECT password
		FROM user
		WHERE email = #{sId}
	</select>

	<update id="updatePassword">
		UPDATE user
		SET password = #{password}
		WHERE email = #{sId}
	</update>	
	

  <!-- =========================
       목록 조회 (페이징) 공고
       ========================= -->
	<select id="selectJobList"
	        parameterType="com.itwillbs.project.comMy.dto.JobCond"
	        resultMap="comJobRowMap">
	  SELECT
	      jp.job_id
	    , jp.title
	    , jp.address
	    , jp.emp_type
	    , DATE_FORMAT(jp.open_date, '%Y.%m.%d')  AS open_date_text
	    , DATE_FORMAT(jp.close_date, '%Y.%m.%d') AS close_date_text
	
	    , CASE
	        WHEN jp.post_status = 1 THEN 'OPEN'
	        ELSE 'CLOSED'
	      END AS post_status_text
	
	    , (
	        SELECT COUNT(*)
	        FROM JOB_APPLICATION ja
	        WHERE ja.job_id = jp.job_id
	      ) AS apply_count
	
	  FROM JOB_POSTING jp
	
	  <include refid="jobWhere"/>
	
	  ORDER BY jp.job_id DESC
	  LIMIT #{page.offset, jdbcType=INTEGER}, #{page.safeSize, jdbcType=INTEGER}
	</select>

  <!-- =========================
       총 개수
       ========================= -->
	<select id="selectJobCount"
	        parameterType="com.itwillbs.project.comMy.dto.JobCond"
	        resultType="int">
	  SELECT COUNT(*)
	  FROM JOB_POSTING jp
	
	  <include refid="jobWhere"/>
	</select>
	
	<select id="getJopManagementCount"
	        parameterType="com.itwillbs.project.comMy.dto.JobCond"
	        resultType="int">
	  SELECT COUNT(*)
	  FROM JOB_POSTING jp
	
	  <include refid="jobWhere"/>
	</select>
	  <!-- =========================
       삭제
       ========================= -->
	<delete id="deleteJob">
	  DELETE FROM JOB_POSTING
	  WHERE comp_id = #{userId}
	    AND job_id = #{jobId}
	</delete>	
		
<!-- ==============================
    결제내역
     parameter:PaymentCond.java
     result: 
============================== -->	
<!-- 리스트 -->
<select id="selectPaymentList" parameterType="com.itwillbs.project.comMy.dto.PaymentCond"
        resultMap="paymentMap">
  SELECT
    p.pay_id,
    p.user_id,
    p.product_id,
    DATE_FORMAT(p.pay_date, '%y.%m.%d %H:%i') AS pay_date_text,
    p.pay_price,
    p.pay_status,
    p.pay_method,
    pr.product_name
  FROM PAY p
  JOIN PRODUCT pr ON pr.product_id = p.product_id

  <include refid="paymentWhere"/>

  ORDER BY p.pay_date DESC
  LIMIT #{page.offset}, #{page.safeSize}
</select>	
	
<!-- 카운트 -->
<select id="selectPaymentCount" parameterType="com.itwillbs.project.comMy.dto.PaymentCond"
        resultType="int">
  SELECT COUNT(*)
  FROM PAY p
  JOIN PRODUCT pr ON pr.product_id = p.product_id

  <include refid="paymentWhere"/>
</select>


</mapper>