<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itwillbs.project.common.mapper.FileMapper">
	
	<!--  파일 상세 정보 조회 - SELECT   -->
	<select id="selectFile" resultType="com.itwillbs.project.common.DTO.FileDTO">
		SELECT 	* 
		FROM 	file 
		WHERE 	file_id = #{fileId}
	</select>

</mapper>