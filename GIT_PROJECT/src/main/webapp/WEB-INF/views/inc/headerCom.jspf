<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>

<header>
	<%-- 상단: 로고 + 로그인/회원가입/마이페이지/로그아웃 --%>
	<section id="header-upper">
	  <nav class="navbar navbar-expand-lg px-3">
	    <a href="<c:url value="/" />">
	      <img src="<c:url value="/resources/images/logo.png" />" 
	           alt="로고" 
	           id="logo"
	           style="width: 180px; height: auto; margin-top: 12px;">
	    </a>
	
	   <div class="ms-auto d-flex flex-column align-items-end">
  
		  <div class="toggle-container d-flex align-items-center justify-content-end gap-3">
		    <span id="label-personal" class="label-text">개인회원</span>
		    <label class="switch">
		      <input type="checkbox" id="member-toggle">
		      <span class="slider"></span>
		    </label>
		    <span id="label-company" class="label-text">기업회원</span>
		  </div>
		
		  <ul class="navbar-nav flex-row gap-4 align-items-center">
		    <c:choose>
		      <c:when test="${empty sessionScope.sId}">
		        <li class="nav-item">
		          <a class="nav-link" href="<c:url value='/user/login' />">로그인</a>
		        </li>
		        <li class="nav-item">
		          <a class="nav-link btn btn-outline-primary px-3" href="<c:url value='/user/regist' />" style="border-radius: 20px;">회원가입</a>
		        </li>
		      </c:when>
		      <c:otherwise>
		        <li class="nav-item">
		          <a class="nav-link p-0" href="<c:url value='/my' />" style="font-size: 16px;">${sessionScope.userName} 님</a>
		        </li>
		        <li class="nav-item">
		          <a class="nav-link text-danger" href="javascript:void(0)" onclick="requestLogout()">로그아웃</a>
		        </li>
		      </c:otherwise>
		    </c:choose>
		  </ul>
		</div>
	  </nav>
	</section>

	<%-- 하단: 메인 메뉴 바 + 전체 메뉴 버튼 --%>
	<section id="header-bottom">
		<nav id="globalMenu"
			class="site-nav navbar navbar-expand border-bottom">
			<div class="container-fluid">

				<!-- 메인 메뉴 -->
				<ul class="navbar-nav main-menu gap-3">

					<!-- 고용관리 -->
					<li class="nav-item dropdown"><a
						class="nav-link dropdown-toggle fw-semibold" href="#"
						id="dropdownReview" role="button" data-bs-toggle="dropdown"
						aria-expanded="false"> 고용관리 </a>
						<ul class="dropdown-menu shadow-sm"
							aria-labelledby="dropdownReview" id="submenu-review">
							<li>
								<a class="dropdown-item" 
								href="<c:url value='/job/JobList' />">채용공고</a>
							</li>
							<li>
								<a class="dropdown-item"
								href="<c:url value='/job/JobPosting' />">공고 등록</a>
							</li>
							<li>
								<a class="dropdown-item" href="<c:url value='/comMy/job' />">내 공고</a>
							</li>
						</ul></li>

					<!-- 요금제 (하위메뉴 없음) -->
					<li class="nav-item"><a class="nav-link fw-semibold"
						href="<c:url value='/store/cstore' />">요금제</a></li>

					<!-- 커뮤니티 -->
					<li class="nav-item dropdown"><a
						class="nav-link dropdown-toggle fw-semibold" href="#"
						id="dropdownBoard" role="button" data-bs-toggle="dropdown"
						aria-expanded="false"> 커뮤니티 </a>
						<ul class="dropdown-menu shadow-sm"
							aria-labelledby="dropdownBoard" id="submenu-board">
							<li><a class="dropdown-item" href="<c:url value='/board' />">자유게시판</a></li>
							<li><a class="dropdown-item"
								href="<c:url value='/board?category=INTERVIEW_REVIEW' />">면접후기</a></li>
						</ul></li>

				</ul>

				<!-- 우측: 전체 메뉴 버튼 -->
				<div class="ms-auto">
					<button id="toggleAllBtn" class="btn btn-outline-secondary btn-sm"
						aria-expanded="false" aria-controls="globalMenu" type="button">
						전체 메뉴</button>
				</div>

				<div id="megaMenu" class="mega-menu-content">
					<div class="mega-menu-inner">
						<div class="menu-group">
							<h6 class="fw-bold">고용관리</h6>
							<ul class="list-unstyled">
								<li><a href="<c:url value='/job/JobList' />">채용공고</a></li>
								<li><a href="<c:url value='/job/JobPosting' />">공고 등록</a></li>
								<li><a href="<c:url value='/comMy/job' />">내 공고</a></li>
							</ul>
						</div>

						<div class="menu-group">
							<h6 class="fw-bold">커뮤니티</h6>
							<ul class="list-unstyled">
								<li><a href="<c:url value='/board' />">자유게시판</a></li>
								<li><a href="<c:url value='#' />">면접후기</a></li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</nav>
	</section>
</header>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
	const toggle = document.getElementById("member-toggle");
    const labelPersonal = document.getElementById("label-personal");
    const labelcompany = document.getElementById("label-company");

    if (!toggle) return;

    // [Step 1] 현재 주소 확인
    const iscompanyURL = window.location.pathname.includes('mainCom');
    // [Step 2] 저장된 모드 확인
    const savedMode = localStorage.getItem('viewMode');

    // [Step 3] 상태 결정 (URL이 기업홈이면 무조건 기업모드, 아니면 저장된 값 따름)
    if (iscompanyURL || savedMode === 'company') {
        toggle.checked = true;
        labelcompany.classList.add('active');
        labelPersonal.classList.remove('active');
        // URL이 기업홈인데 저장값이 없다면 저장해줌 (동기화)
        if(iscompanyURL) localStorage.setItem('viewMode', 'company');
    } else {
        toggle.checked = false;
        labelPersonal.classList.add('active');
        labelcompany.classList.remove('active');
    }

    // [Step 4] 토글 클릭 시 동작
    toggle.addEventListener('change', function() {
        if(this.checked) {
            localStorage.setItem('viewMode', 'company');
            location.href = "<c:url value='/mainCom' />";
        } else {
            localStorage.setItem('viewMode', 'personal');
            location.href = "<c:url value='/' />";
        }
    });
 	    
    const toggleBtn = document.getElementById('toggleAllBtn');
    const megaMenu = document.querySelector('#megaMenu');

    if (toggleBtn && megaMenu) {
    	// 1. 버튼 클릭 이벤트
        toggleBtn.addEventListener('click', function(e) {
        	e.preventDefault();
        	e.stopPropagation();
            
        	const hasActive = megaMenu.classList.contains('active');

        	if (hasActive) {
		        megaMenu.classList.remove('active');
		        console.log("명령: active 제거됨");
		    } else {
		        // 제거 시도함이 떴었다면, 강제로 한번 더 지웠다가 다시 넣는 '새로고침' 전략
		        megaMenu.classList.remove('active'); 
		        // 약간의 시간차를 두어 브라우저가 변화를 인지하게 함
		        setTimeout(() => {
		            megaMenu.classList.add('active');
		            console.log("명령: active 강제 주입 완료");
		            console.log("현재 클래스 리스트:", megaMenu.className);
		        }, 0);
		    }
        	
        });
    	
     // 2. 메뉴 내부 클릭 시에는 닫히지 않게 보호
        megaMenu.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    	
        // 메뉴 외부 클릭 시 닫힘
        document.addEventListener('click', function(e) {
        	if (megaMenu.classList.contains('active')) {
                megaMenu.classList.remove('active');
                console.log("외부 클릭으로 닫힘");
            }
        });
    }
});
</script>