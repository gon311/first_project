<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<header>
  <%-- 상단: 로고 + 로그인/회원가입/마이페이지/로그아웃 --%>
  <%-- 차후 url 교체 --%>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
    <!-- 좌측: 브랜드 -->
    <img src="<c:url value="/resources/images/logo.png" />" alt="로고" class="img-fluid" style="max-width:80px;">

    <!-- 우측: 인증 관련 메뉴 -->
    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
      <c:choose>
        <c:when test="${empty sessionScope.sId}">
          <li class="nav-item">
            <a class="nav-link" href="<c:url value='/member/login' />">로그인</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<c:url value='/member/regist' />">회원가입</a>
          </li>
        </c:when>
        <c:otherwise>
          <li class="nav-item">
            <a class="nav-link" href="<c:url value='/member/info' />">${memberName} 님</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="javascript:void(0)" onclick="requestLogout()">로그아웃</a>
          </li>
        </c:otherwise>
      </c:choose>
    </ul>
  </nav>

  <%-- 하단: 메인 메뉴 바 + 전체 메뉴 버튼 --%>
  <%-- 차후 url 교체 --%>
  <nav id="globalMenu" class="site-nav navbar navbar-expand bg-light border-bottom">
    <div class="container-fluid">
      <!-- 메인 메뉴 -->
      <ul class="navbar-nav main-menu gap-3">
        <!-- 채용공고 (하위메뉴 없음) -->
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="<c:url value='/jobs' />">채용공고</a>
        </li>

        <!-- AI 자소서 첨삭 -->
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle fw-semibold"
            href="#"
            id="dropdownAI"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
            AI 자소서 첨삭
          </a>
          <ul class="dropdown-menu shadow-sm" aria-labelledby="dropdownAI" id="submenu-ai">
            <li><a class="dropdown-item" href="<c:url value='/ai/analysis' />">자소서 첨삭</a></li>
            <li><a class="dropdown-item" href="<c:url value='/ai/spellcheck' />">맞춤법 검사</a></li>
            <li><a class="dropdown-item" href="<c:url value='/ai/plagiarism' />">표절 검사</a></li>
          </ul>
        </li>

        <!-- 이력서 관리 -->
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle fw-semibold"
            href="#"
            id="dropdownResume"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
            이력서 관리
          </a>
          <ul class="dropdown-menu shadow-sm" aria-labelledby="dropdownResume" id="submenu-resume">
            <li><a class="dropdown-item" href="<c:url value='/resume/write' />">이력서 작성</a></li>
            <li><a class="dropdown-item" href="<c:url value='/resume/mine' />">내 이력서</a></li>
          </ul>
        </li>

        <!-- 커뮤니티 -->
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle fw-semibold"
            href="#"
            id="dropdownCommunity"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
            커뮤니티
          </a>
          <ul class="dropdown-menu shadow-sm" aria-labelledby="dropdownCommunity" id="submenu-community">
            <li><a class="dropdown-item" href="<c:url value='/community/free' />">자유게시판</a></li>
            <li><a class="dropdown-item" href="<c:url value='/community/reviews' />">면접후기</a></li>
          </ul>
        </li>

        <!-- 요금제 (하위메뉴 없음) -->
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="<c:url value='/pricing' />">요금제</a>
        </li>
      </ul>

      <!-- 우측: 전체 메뉴 버튼 -->
      <div class="ms-auto">
        <button id="toggleAllBtn"
                class="btn btn-outline-secondary btn-sm"
                aria-expanded="false"
                aria-controls="globalMenu"
                type="button">
          전체 메뉴
        </button>
      </div>
    </div>
  </nav>
</header>

<hr>