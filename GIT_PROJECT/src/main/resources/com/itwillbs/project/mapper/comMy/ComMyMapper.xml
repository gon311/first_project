	<!-- MyQnaDTO -->
	<resultMap id="qnaMap" type="com.itwillbs.project.comMy.dto.MyQnaDTO">
	    <id     property="qnaId"        column="qna_id"/>
	    <result property="qnaCategory"  column="qna_category"/>
	    <result property="qnaTitle"     column="qna_title"/>
	    <result property="qnaContent"   column="qna_content"/>
	    <result property="writerId"     column="writer_id"/>
	    <result property="regDate"      column="reg_date"/>
	    <result property="reStatus"     column="re_status"/>
	    <result property="reDate"       column="re_date"/>
	    <result property="reContent"    column="re_content"/>
	    <result property="isDeleted"    column="is_deleted"/>
	    <result property="regDateText"  column="reg_date_text"/>
	    <result property="statusText"   column="status_text"/>
	</resultMap>
	
   
   <!-- =========================
       공통 where 조건
       - userId(comp_id)
       - status(all/open/closed)
       - q(검색: title/field)
       ========================= -->
	<sql id="jobWhere">
	  WHERE jp.comp_id = #{userId}
	
	  <if test="status != null and status != '' and status != 'all'">
	    <choose>
	      <when test="status == 'open'">
	        AND jp.post_status = 1
	      </when>
	      <when test="status == 'closed'">
	        AND jp.post_status &lt;&gt; 1
	      </when>
	    </choose>
	  </if>
	
	  <if test="q != null and q != ''">
	    AND (
	         jp.title LIKE CONCAT('%', #{q}, '%')
	      OR jp.field LIKE CONCAT('%', #{q}, '%')
	    )
	  </if>
	</sql>
	
	<!-- 결제 -->
<sql id="paymentWhere">
  WHERE p.user_id = #{userId}

  <!-- 기간 필터: period = 3m/6m/1y/5y -->
  <if test="period != null and period != ''">
    <choose>
      <when test="period == '3m'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 3 MONTH)
      </when>
      <when test="period == '6m'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 6 MONTH)
      </when>
      <when test="period == '1y'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 1 YEAR)
      </when>
      <when test="period == '5y'">
        AND p.pay_date &gt;= DATE_SUB(NOW(), INTERVAL 5 YEAR)
      </when>
      <otherwise>
        <!-- 아무것도 안 함-->
      </otherwise>
    </choose>
  </if>

  <!-- 상태 필터: status=all이면 조건 제외 -->
  <if test="status != null and status != '' and status != 'all'">
    <!-- DB enum이 ready/paid/cancelled라면 그대로 매칭 -->
    AND p.pay_status = #{status}
  </if>

  <!-- 검색어: 상품명 기준 -->
  <if test="q != null and q != ''">
    AND pr.product_name LIKE CONCAT('%', #{q}, '%')
  </if>
</sql>

<!-- 문의내역 -->
<sql id="qnaWhere">
  WHERE q.writer_id = #{userId}
    AND q.is_deleted = 'N'

  <if test="status != null and status != '' and status != 'all'">
    AND q.re_status = #{status}
  </if>

  <if test="q != null and q != ''">
    AND (
         q.qna_title LIKE CONCAT('%', #{q}, '%')
      OR q.qna_content LIKE CONCAT('%', #{q}, '%')
      OR q.qna_category LIKE CONCAT('%', #{q}, '%')
    )
  </if>
</sql>


<!-- ==============================
     내정보 조회
     parameter: sId
     result: ComMyDTO
============================== -->
	<select id="selectUser" parameterType="string" resultMap="userMap">
		SELECT
			u.user_id,
			u.email,
			u.user_name,
			u.phone,
			u.user_type,

			uc.biz_reg_no,
			uc.company_name,
			uc.ceo_name,
			uc.company_address,
			uc.pass_count,

			cp.pay_id,
			cp.product_id,
			p.product_name,
			cp.start_date,
			cp.end_date,
			cp.use_status
		FROM user u
		LEFT JOIN user_company uc
			ON u.user_id = uc.user_id
		LEFT JOIN com_product cp
			ON u.user_id = cp.user_id
		   AND cp.use_status = 'active'
		LEFT JOIN product p
			ON cp.product_id = p.product_id
		WHERE u.email = #{sId}
	</select>
	
<!-- ==============================
     내정보 수정 저장
     parameter: MyDTO (email, userName, phone ...)
     result: int (affected rows)
============================== -->
	<update id="updateUser" parameterType="com.itwillbs.project.comMy.dto.ComMyDTO">
		UPDATE user u
		JOIN user_company uc ON u.user_id = uc.user_id
		SET u.user_name = #{userName},
		    u.phone = #{phone},
		    uc.company_name = #{companyName},
		    uc.ceo_name = #{ceoName},
		    uc.company_address = #{companyAddress}
		WHERE u.email = #{email}
	</update>
	
<!-- ==============================
     비밀번호 변경
     parameter: PasswordChangeDTO.java
     result: String
============================== -->	
	<select id="selectPassword" parameterType="string" resultType="string">
		SELECT password
		FROM user
		WHERE email = #{sId}
	</select>

	<update id="updatePassword">
		UPDATE user
		SET password = #{password}
		WHERE email = #{sId}
	</update>	
	

  <!-- =========================
       목록 조회 (페이징) 공고
       ========================= -->
	<select id="selectJobList"
	        parameterType="com.itwillbs.project.comMy.dto.JobCond"
	        resultMap="comJobRowMap">
	  SELECT
	      jp.job_id
	    , jp.title
	    , jp.address
	    , jp.emp_type
	    , DATE_FORMAT(jp.open_date, '%Y.%m.%d')  AS open_date_text
	    , DATE_FORMAT(jp.close_date, '%Y.%m.%d') AS close_date_text
	
	    , CASE
	        WHEN jp.post_status = 1 THEN 'OPEN'
	        ELSE 'CLOSED'
	      END AS post_status_text
	
	    , (
	        SELECT COUNT(*)
	        FROM JOB_APPLICATION ja
	        WHERE ja.job_id = jp.job_id
	      ) AS apply_count
	
	  FROM JOB_POSTING jp
	
	  <include refid="jobWhere"/>
	
	  ORDER BY jp.job_id DESC
	  LIMIT #{page.offset, jdbcType=INTEGER}, #{page.safeSize, jdbcType=INTEGER}
	</select>

  <!-- =========================
       총 개수
       ========================= -->
	<select id="selectJobCount"
	        parameterType="com.itwillbs.project.comMy.dto.JobCond"
	        resultType="int">
	  SELECT COUNT(*)
	  FROM JOB_POSTING jp
	
	  <include refid="jobWhere"/>
	</select>
	
	<select id="getJopPostingCount"
	        parameterType="com.itwillbs.project.comMy.dto.JobCond"
	        resultType="int">
	  SELECT COUNT(*)
	  FROM JOB_POSTING jp
	
	</select>
	
	<select id="getJopManagementCount"
	        parameterType="com.itwillbs.project.comMy.dto.JobCond"
	        resultType="int">
	  SELECT COUNT(*)
	  FROM JOB_POSTING jp
	
	  <include refid="jobWhere"/>
	</select>
	  <!-- =========================
       삭제
       ========================= -->
	<delete id="deleteJob">
	  DELETE FROM JOB_POSTING
	  WHERE comp_id = #{userId}
	    AND job_id = #{jobId}
	</delete>	
		
<!-- ==============================
    결제내역
     parameter:PaymentCond.java
     result: 
============================== -->	
<!-- 리스트 -->
<select id="selectPaymentList" parameterType="com.itwillbs.project.comMy.dto.PaymentCond"
        resultMap="paymentMap">
  SELECT
    p.pay_id,
    p.user_id,
    p.product_id,
    DATE_FORMAT(p.pay_date, '%y.%m.%d %H:%i') AS pay_date_text,
    p.pay_price,
    p.pay_status,
    p.pay_method,
    pr.product_name
  FROM PAY p
  JOIN PRODUCT pr ON pr.product_id = p.product_id

  <include refid="paymentWhere"/>

  ORDER BY p.pay_date DESC
  LIMIT #{page.offset}, #{page.safeSize}
</select>	
	
<!-- 카운트 -->
<select id="selectPaymentCount" parameterType="com.itwillbs.project.comMy.dto.PaymentCond"
        resultType="int">
  SELECT COUNT(*)
  FROM PAY p
  JOIN PRODUCT pr ON pr.product_id = p.product_id

  <include refid="paymentWhere"/>
</select>

<!-- ==============================
    문의 내역
     parameter:QnaCond.java
     result: 
============================== -->	
	<select id="selectQnaList"
	        parameterType="com.itwillbs.project.comMy.dto.QnaCond"
	        resultMap="qnaMap">
	  SELECT
	      q.qna_id
	    , q.qna_category
	    , q.qna_title
	    , q.qna_content
	    , q.writer_id
	    , q.reg_date
	    , q.re_status
	    , q.re_date
	    , q.re_content
	    , q.is_deleted
	    , DATE_FORMAT(q.reg_date, '%Y-%m-%d') AS reg_date_text
	    , CASE
	        WHEN q.re_status = 'completed' THEN '답변완료'
	        ELSE '답변대기'
	      END AS status_text
	  FROM qna q
	
	  <include refid="qnaWhere"/>
	
	  ORDER BY q.qna_id DESC
	  LIMIT #{page.offset, jdbcType=INTEGER}, #{page.safeSize, jdbcType=INTEGER}
	</select>
	
	<select id="selectQnaCount"
	        parameterType="com.itwillbs.project.comMy.dto.QnaCond"
	        resultType="int">
	  SELECT COUNT(*)
	  FROM qna q
	
	  <include refid="qnaWhere"/>
	</select>	


</mapper>