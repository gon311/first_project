<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
  
<configuration>
	
	<!-- DB 컬럼명과 DTO 클래스 필드명의 불일치 해결을 위한 자동 변환 설정(DB 컬럼명 -> DTO 클래스 필드명) -->
	<!-- settings 태그 내의 setting 태그를 사용하여 name 속성값 "mapUnderScoreToCamelCase" 고정, value 속성값 "true" 설정 -->
	<settings>
		<setting name="mapUnderscoreToCamelCase" value="true"/>
	</settings>

	<typeAliases>
		<typeAlias type="com.itwillbs.project.admin.dto.MemberDTO" alias="member"/>
		<typeAlias type="com.itwillbs.project.admin.dto.NoticeDTO" alias="notice"/>
		<typeAlias type="com.itwillbs.project.admin.dto.JobPostDTO" alias="jobPost"/>
		<typeAlias type="com.itwillbs.project.admin.dto.ProductDTO" alias="product"/>
		
	</typeAliases>

</configuration>