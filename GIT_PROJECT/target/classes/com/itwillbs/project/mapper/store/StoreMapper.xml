<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.itwillbs.project.store.mapper.StoreMapper">

	<!-- 구매할 상품 정보 조회 -->
	<select id="selectStoreInfo" resultType="store">
		select	*
		from
			product
		where
			product_id = #{productId}
	</select>
	
	<!-- 회원 정보 출력 -->
	<select id="selectOrderUser" resultType="order">
		select	
			*
		from	
			user
		where
			email = #{sId}
	</select>
	
</mapper>