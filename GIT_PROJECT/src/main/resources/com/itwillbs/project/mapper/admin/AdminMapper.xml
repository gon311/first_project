<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.itwillbs.project.admin.mapper.AdminMapper">

	<resultMap id="memberResultMap" type="com.itwillbs.project.admin.dto.MemberDTO">
		<id property="id" column="user_id" />
		<result property="email" column="email" />
		<result property="password" column="password" />
		<result property="phone" column="phone" />
		<result property="name" column="user_name" />
		<result property="memberType" column="user_type" />
		<result property="status" column="status" />
		<result property="joinedAt" column="joined_at" />
		<result property="withdrawnAt" column="withdrawn_at" />
	</resultMap>
	
	<!-- 구직자 목록 조회 -->
	<select id="selectUserList" resultMap="memberResultMap">
		select 
			*
		from 
			user
		where
			user_type = 'c'
			<if test="status != null and !status.equals('')">
				and
					status = #{status}
			</if>
			<if test="keyword != null and !keyword.equals('')">
				and
					user_name like concat('%',#{keyword},'%')
			</if>
	</select>
	
	<!-- 구직자 상세정보 조회 -->
	<select id="selectUserInfo" resultMap="memberResultMap">
		select 
			user_id
			, email
			, password
			, phone
			, user_name
			, user_type
			, status
			, joined_at
			, withdrawn_at
		from 
			user
		where
			user_id = #{id}
		
	</select>
	
	
	<!-- 기업회원 목록 조회 -->
	<select id="selectComList" resultMap="memberResultMap">
		select 
			*
		from 
			user
		where
			user_type = 'p'
			<if test="status != null and !status.equals('')">
				and
					status = #{status}
			</if>
			<if test="keyword != null and !keyword.equals('')">
				and
					user_name like concat('%',#{keyword},'%')
			</if>
	</select>
	
