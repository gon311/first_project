	<!-- ==================================================================== -->
	<!-- 공지사항 리스트 조회 -->
	<select id="getNoticeList" resultType="notice">
		SELECT
		 	notice_id
		 	, notice_title
		 	, notice_content
		 	, reg_date
		 	, readcount
		 	, user_type
		 	, update_date
		 	, status
		 FROM notice
	</select>
	<!-- 공지사항 작성 -->
	<insert id ="insertNotice" parameterType="notice">
		INSERT INTO notice (
			notice_title
			, notice_content
			, reg_date
			, readcount
			, user_type
			, status
		) VALUES (
			#{notice_title}
			, #{notice_content}
			, NOW()
			,0
			, #{user_type}
			, #{status}
		)
	</insert>
	<!-- 공지사항 상세 조회 -->
	<select id="getNoticeById" resultType = "notice">
		SELECT 
			notice_id
			, notice_title
			, notice_content
			, reg_date
			, readcount
		FROM notice
		WHERE notice_id = #{notice_id}
	
	</select>
	
	<!-- 조회수 증가 -->
	<update id="updateReadCount">
		UPDATE notice
		SET readcount = readcount + 1
		WHERE notice_id = #{notice_id}
	</update>
	
	<!-- ================================================================================== -->
	<!-- 결제 목록 조회 -->
	<resultMap id="payResultMap" type="com.itwillbs.project.admin.dto.PayDTO">
		<id property="id" column="pay_id" />
		<result property="userId" column="user_id" />
		<result property="userType" column="user_type" />
		<result property="productId" column="product_id" />
		<result property="productName" column="product_name" />
		<result property="payMethod" column="pay_method" />
		<result property="cardName" column="card_name" />
		<result property="cardNum" column="card_num" />
		<result property="bankName" column="bank_name" />
		<result property="depositAccount" column="deposit_account" />
		<result property="depositName" column="deposit_name" />
		<result property="payPrice" column="pay_price" />
		<result property="payDate" column="pay_date" />
		<result property="payStatus" column="pay_status" />
	</resultMap>
	
	<select id="selectPayList" resultMap="payResultMap">
		select 
			p.pay_id
			, p.user_id
			, u.user_type
			, p.product_id
			, pd.product_name
			, p.pay_method
			, p.card_name
			, p.bank_name
			, p.deposit_account
			, p.deposit_name
			, p.pay_price
			, p.pay_date
			, p.pay_status
		from 
			pay p join product pd
		on 
			p.product_id = pd.product_id
		join
			user u
		on p.user_id = u.user_id
	</select>
	
	<!-- ================================================================================== -->
	<!-- 제출된 공고 목록 조회 -->
	<resultMap id="submitResultMap" type="com.itwillbs.project.admin.dto.SubmitDTO">
		<id property="id" column="job_id" />
		<result property="compId" column="comp_id" />
		<result property="title" column="title" />
		<result property="field" column="field" />
		<result property="task" column="task" />
		<result property="expType" column="exp_type" />
		<result property="expYear" column="exp_year" />
		<result property="edu" column="edu" />
		<result property="empType" column="emp_type" />
		<result property="probation" column="probation" />
		<result property="salary" column="salary" />
		<result property="address" column="address" />
		<result property="isRemote" column="is_remote" />
		<result property="openDate" column="open_date" />
		<result property="closeDate" column="close_date" />
		<result property="mgrName" column="mgr_name" />
		<result property="mgrPhone" column="mgr_phone" />
		<result property="mgrEmail" column="mgr_email" />
		<result property="isPublic" column="is_public" />
		<result property="postStatus" column="post_status" />
	</resultMap>
	
	<select id="selectSubmitList" resultMap="submitResultMap">
		select 
			*
		from 
			job_posting
	</select>
	
	
	
	
	
	
	
	
	
	
