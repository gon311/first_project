<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itwillbs.project.job.mapper.JobMapper">
	
	<insert id="insertJob">
	    INSERT INTO JOB_POSTING (
	        comp_id, 
	        title, 
	        field, 
	        task, 
	        exp_type, 
	        exp_year, 
	        edu, 
	        emp_type, 
	        probation, 
	        salary, 
	        address, 
	        is_remote, 
	        open_date, 
	        close_date, 
	        mgr_name, 
	        mgr_phone, 
	        mgr_email, 
	        is_public, 
	        post_status
	    ) VALUES (
	        #{compId},       
	        #{title}, 
	        #{field}, 
	        #{task}, 
	        #{expType}, 
	        #{expYear}, 
	        #{edu}, 
	        #{empType},
	        <choose>
	            <when test="probation != null and probation == 'Y'">
	                #{probation},
	            </when>
	            <otherwise>
	                DEFAULT,
	            </otherwise>
	        </choose>
	        #{salary}, 
	        #{address},
	        <choose>
	            <when test="isRemote != null and isRemote == 'Y'">
	                #{isRemote},
	            </when>
	            <otherwise>
	                DEFAULT,
	            </otherwise>
	        </choose>
	        #{openDate}, 
	        #{closeDate}, 
	        #{mgrName}, 
	        #{mgrPhone}, 
	        #{mgrEmail}, 
	        #{isPublic}, 
	        1                )
	</insert>
	
</mapper>


























