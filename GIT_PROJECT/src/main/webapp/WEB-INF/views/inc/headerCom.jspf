<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>

<header>
	<%-- 상단: 로고 + 로그인/회원가입/마이페이지/로그아웃 --%>
	<section id="header-upper">
		<nav class="navbar navbar-expand-lg navbar-dark px-3">
			<!-- 좌측: 브랜드 -->
			<a href="<c:url value="/mainCom" />">
			    <img src="<c:url value="/resources/images/logo.png" />" 
				         alt="로고" 
				         class="img-fluid" 
				         id="logo"
				         style="width: 180px; height: auto; margin-top: 12px;">
	         </a>
			<!-- 우측: 인증 관련 메뉴 -->
			<ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
				<c:choose>
					<c:when test="${empty sessionScope.sId}">
						<li class="nav-item"><a class="nav-link"
							href="<c:url value='/user/login' />">로그인</a></li>
						<li class="nav-item"><a class="nav-link"
							href="<c:url value='/user/regist' />">회원가입</a></li>
						<li class="nav-item">
							<a class="nav-link" href="<c:url value='/' />">개인회원</a>	
				        </li>	
					</c:when>
					<c:otherwise>
						<li class="nav-item">
							<a class="nav-link"
							href="<c:url value='/my' />">${sessionScope.userName} 님</a>
						</li>
						<li class="nav-item">
							<a class="nav-link"
							href="javascript:void(0)" onclick="requestLogout()">로그아웃</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="<c:url value='/' />">개인홈</a>	
						</li>
					</c:otherwise>
				</c:choose>
			</ul>
		</nav>
	</section>

	<%-- 하단: 메인 메뉴 바 + 전체 메뉴 버튼 --%>
	<section id="header-bottom">
		<nav id="globalMenu"
			class="site-nav navbar navbar-expand border-bottom">
			<div class="container-fluid">

				<!-- 메인 메뉴 -->
				<ul class="navbar-nav main-menu gap-3">

					<!-- 고용관리 -->
					<li class="nav-item dropdown"><a
						class="nav-link dropdown-toggle fw-semibold" href="#"
						id="dropdownReview" role="button" data-bs-toggle="dropdown"
						aria-expanded="false"> 고용관리 </a>
						<ul class="dropdown-menu shadow-sm"
							aria-labelledby="dropdownReview" id="submenu-review">
							<li>
								<a class="dropdown-item" 
								href="<c:url value='/job/JobList' />">채용공고</a>
							</li>
							<li>
								<a class="dropdown-item"
								href="<c:url value='/job/JobPosting' />">공고 등록</a>
							</li>
							<li>
								<a class="dropdown-item" href="<c:url value='/job/JobManagement' />">내 공고</a>
							</li>
						</ul></li>

					<!-- 요금제 (하위메뉴 없음) -->
					<li class="nav-item"><a class="nav-link fw-semibold"
						href="<c:url value='/store/cstore' />">요금제</a></li>

					<!-- 커뮤니티 -->
					<li class="nav-item dropdown"><a
						class="nav-link dropdown-toggle fw-semibold" href="#"
						id="dropdownBoard" role="button" data-bs-toggle="dropdown"
						aria-expanded="false"> 커뮤니티 </a>
						<ul class="dropdown-menu shadow-sm"
							aria-labelledby="dropdownBoard" id="submenu-board">
							<li><a class="dropdown-item" href="<c:url value='/board' />">자유게시판</a></li>
							<li><a class="dropdown-item"
								href="<c:url value='/board?category=INTERVIEW_REVIEW' />">면접후기</a></li>
						</ul></li>

				</ul>

				<!-- 우측: 전체 메뉴 버튼 -->
				<div class="ms-auto">
					<button id="toggleAllBtn" class="btn btn-outline-secondary btn-sm"
						aria-expanded="false" aria-controls="globalMenu" type="button">
						전체 메뉴</button>
				</div>

				<div id="megaMenu" class="mega-menu-content">
					<div class="mega-menu-inner">
						<div class="menu-group">
							<h6 class="fw-bold">고용관리</h6>
							<ul class="list-unstyled">
								<li><a href="<c:url value='/job/JobList' />">채용공고</a></li>
								<li><a href="<c:url value='/job/JobPosting' />">공고 등록</a></li>
								<li><a href="<c:url value='/job/JobManagement' />">내 공고</a></li>
							</ul>
						</div>

						<div class="menu-group">
							<h6 class="fw-bold">커뮤니티</h6>
							<ul class="list-unstyled">
								<li><a href="<c:url value='/board' />">자유게시판</a></li>
								<li><a href="<c:url value='#' />">면접후기</a></li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</nav>
	</section>
</header>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('toggleAllBtn');
    const megaMenu = document.querySelector('#megaMenu');

    if (toggleBtn && megaMenu) {
    	// 1. 버튼 클릭 이벤트
        toggleBtn.addEventListener('click', function(e) {
        	e.preventDefault();
        	e.stopPropagation();
            
        	const hasActive = megaMenu.classList.contains('active');

        	if (hasActive) {
		        megaMenu.classList.remove('active');
		        console.log("명령: active 제거됨");
		    } else {
		        // 제거 시도함이 떴었다면, 강제로 한번 더 지웠다가 다시 넣는 '새로고침' 전략
		        megaMenu.classList.remove('active'); 
		        // 약간의 시간차를 두어 브라우저가 변화를 인지하게 함
		        setTimeout(() => {
		            megaMenu.classList.add('active');
		            console.log("명령: active 강제 주입 완료");
		            console.log("현재 클래스 리스트:", megaMenu.className);
		        }, 0);
		    }
        	
        });
    	
     // 2. 메뉴 내부 클릭 시에는 닫히지 않게 보호
        megaMenu.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    	
        // 메뉴 외부 클릭 시 닫힘
        document.addEventListener('click', function(e) {
        	if (megaMenu.classList.contains('active')) {
                megaMenu.classList.remove('active');
                console.log("외부 클릭으로 닫힘");
            }
        });
    }
});
</script>