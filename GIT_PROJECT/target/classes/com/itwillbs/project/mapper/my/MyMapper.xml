<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itwillbs.project.my.mapper.MyMapper">

<!-- ==============================
     resultMap
============================== -->
	<!-- MyDTO -->
	<resultMap id="userMap" type="com.itwillbs.project.my.dto.MyDTO">
	  <id     property="userId"   column="user_id" />
	  <result property="email"    column="email" />
	  <result property="userName" column="user_name" />
	  <result property="phone"    column="phone" />
	  <result property="userType" column="user_type" />
	</resultMap>
	
	<!-- MyResumeDTO -->
	<resultMap id="resumeMap" type="com.itwillbs.project.my.dto.MyResumeDTO">
	  <id     property="resumeMyId" column="resume_my_id"/>
	
	  <result property="userId"     column="user_id"/>
	  <result property="resumeId"   column="resume_id"/>
	
	  <result property="title"      column="title"/>
	  <result property="status"     column="status"/>
	  <result property="memo"       column="memo"/>
	
	  <result property="createdAt"  column="created_at"/>
	  <result property="updatedAt"  column="updated_at"/>
	  <result property="isDeleted"  column="is_deleted"/>
	  <result property="updatedAtStr" column="updated_at_str"/>
	</resultMap>
	
	
	
	
<!-- ==============================
     내정보 조회
     parameter: sId
     result: MyDTO
============================== -->
	<select id="selectUser" parameterType="string" resultMap="userMap">
		SELECT user_id, email, user_name, phone, user_type
		FROM user
		WHERE email = #{sId}
	</select>


<!-- ==============================
     내정보 수정 저장
     parameter: MyDTO (email, userName, phone ...)
     result: int (affected rows)
============================== -->
	<update id="updateUser" parameterType="com.itwillbs.project.my.dto.MyDTO">
		 UPDATE user
		 SET user_name = #{userName},
		     phone = #{phone}
		 WHERE email = #{email}
	</update>
	
<!-- ==============================
     비밀번호 변경
     parameter: PasswordChangeDTO.java
     result: String
============================== -->	
	<select id="selectPassword" parameterType="string" resultType="string">
		SELECT password
		FROM user
		WHERE email = #{sId}
	</select>

	<update id="updatePassword">
		UPDATE user
		SET password = #{password}
		WHERE email = #{sId}
	</update>
	
<!-- ==============================
     이력서 내력조회 , 최근
     parameter: MyResumeDTO.java
     result: Long
============================== -->	
	<select id="selectMyResumeList" resultMap="resumeMap">
	  SELECT
	      resume_my_id
	    , user_id
	    , resume_id
	    , title
	    , status
	    , memo
	    , created_at
	    , updated_at
	    , DATE_FORMAT(updated_at, '%Y-%m-%d %H:%i') AS updated_at_str
	    , is_deleted
	  FROM resume_my
	  WHERE user_id = #{userId}
	    AND is_deleted = 0
	  ORDER BY updated_at DESC, resume_my_id DESC
	</select>

	<select id="selectTopResume" resultMap="resumeMap">
		SELECT
			resume_my_id
			, user_id
			, resume_id
			, title
			, status
			, memo
			, created_at
			, updated_at
			, DATE_FORMAT(updated_at, '%Y-%m-%d %H:%i') AS updated_at_str
			, is_deleted
		FROM resume_my
		WHERE user_id = #{userId}
			AND is_deleted = 0
		ORDER BY
			(status = 'COMPLETE') DESC
			, updated_at DESC
			, resume_my_id DESC
		LIMIT 1
	</select>
	

	
</mapper>